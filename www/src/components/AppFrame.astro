---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  priority = false,
  sizes = "(min-width: 1220px) 1180px, 100vw",
} = Astro.props;
---

<!-- A captured app page in a window frame. -->
<div
  class:list={[
    "relative rounded-[14px] border border-line-strong bg-surface p-[5px] shadow-[0_0_0_1px_rgb(0_0_0/0.6),0_30px_80px_-30px_rgb(0_0_0/0.9)] sm:rounded-[16px] sm:p-1.5",
    className,
  ]}
>
  <div class="relative overflow-hidden rounded-[10px] [container-type:inline-size] sm:rounded-[11px]">
    <Image
      src={src}
      alt={alt}
      widths={[720, 1180, 1600, 2360]}
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      class="block h-auto w-full"
    />
    <!-- macOS draws the traffic lights natively, so the page capture doesn't have them. -->
    <div aria-hidden="true" class="absolute top-[3%] left-[1.25%] flex gap-[0.62cqw]">
      <span class="aspect-square w-[0.85cqw] rounded-full bg-[#ff5f57]"></span>
      <span class="aspect-square w-[0.85cqw] rounded-full bg-[#febc2e]"></span>
      <span class="aspect-square w-[0.85cqw] rounded-full bg-[#28c840]"></span>
    </div>
    <slot />
  </div>
</div>
