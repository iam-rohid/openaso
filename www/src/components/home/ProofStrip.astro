---
const points = [
  { value: "$0", label: "Free forever" },
  { value: "MIT", label: "Open source" },
  { value: "0", label: "Accounts needed" },
  { value: "51", label: "Storefronts" },
  { value: "3", label: "Desktop platforms" },
];
---

<section aria-label="At a glance" class="mx-auto max-w-6xl px-4 pt-10 pb-6 sm:px-6">
  <ul
    class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-5"
    data-reveal-stagger="70"
  >
    {points.map((p, i) => (
      <li
        data-reveal
        class:list={[
          "flex flex-col items-center gap-1 bg-bg px-4 py-6 text-center",
          i === points.length - 1 && "col-span-2 sm:col-span-1",
        ]}
      >
        <span class="font-mono text-2xl font-medium tracking-tight text-fg">{p.value}</span>
        <span class="text-[13px] text-dim">{p.label}</span>
      </li>
    ))}
  </ul>
</section>
