---
import { RELEASES_URL, REPO_URL } from "../consts";
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-10 text-[13px] text-dim sm:flex-row sm:justify-between sm:px-6">
    <p>OpenASO · MIT licensed · Not affiliated with Apple.</p>
    <div class="flex gap-5">
      <a href={REPO_URL} class="transition-colors hover:text-fg">
        GitHub
      </a>
      <a href={RELEASES_URL} class="transition-colors hover:text-fg">
        Releases
      </a>
    </div>
  </div>
</footer>
