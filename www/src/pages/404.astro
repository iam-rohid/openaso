---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found · OpenASO">
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-32 text-center">
    <p class="text-sm font-medium text-neutral-500">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <a href="/" class="mt-8 inline-block text-sm underline underline-offset-2">
      Back to home
    </a>
  </main>
  <Footer />
</Layout>
